---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/lora';
import '@/styles/global.css';
import { ThemeControl, MobileNavigation } from '@/components/SiteControls';
import CharacterIcon from '@/components/CharacterIcon';
import { getNavigation } from '@/lib/docs';
interface Props {
  title: string;
  description?: string;
  current?: string;
}
const {
  title,
  description = 'Four little companions for your next big idea. A portable, open-source C++17 animation SDK for embedded screens.',
  current,
} = Astro.props;
const navigation = await getNavigation();
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-character="mochi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · Mochi</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · Mochi`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/brand/repository-cover.jpg', Astro.site)} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (() => {
        let p = {};
        try {
          p = JSON.parse(localStorage.getItem('mochi.preferences') || '{}') || {};
        } catch {}
        const mode = ['light', 'dark', 'system'].includes(p.theme) ? p.theme : 'system';
        const root = document.documentElement;
        root.dataset.theme = mode;
        root.dataset.character = ['mochi', 'sprout', 'peach', 'nimbus'].includes(p.character)
          ? p.character
          : 'mochi';
        root.classList.toggle(
          'dark',
          mode === 'dark' ||
            (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches),
        );
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Mochi home">
          <CharacterIcon />
          <span>
            mochi<span class="brand-period">.</span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="/#playground" aria-current={!current ? 'page' : undefined}>
            Playground
          </a>
          <a href="/docs/introduction/" aria-current={current ? 'page' : undefined}>
            Documentation
          </a>
          <a href="https://github.com/prabhavalabs/mochi">GitHub ↗</a>
        </nav>
        <div class="header-tools">
          <ThemeControl client:load />
          <MobileNavigation client:load entries={navigation} current={current} />
        </div>
      </div>
    </header>
    <noscript>
      <nav class="no-script-nav" aria-label="Documentation contents">
        {navigation.map((entry) => (
          <a href={`/docs/${entry.slug}/`}>{entry.title}</a>
        ))}
      </nav>
    </noscript>
    <slot />
    <footer class="site-footer">
      <div>
        <a href="/" class="brand footer-brand">
          mochi.
        </a>
        <p>A little life for your screen.</p>
        <p class="footer-origin">
          Built in Sri Lanka <span aria-hidden="true">🇱🇰</span>
        </p>
      </div>
      <nav aria-label="Footer navigation">
        <a href="https://github.com/prabhavalabs/mochi">GitHub ↗</a>
        <a href="/docs/license/">MIT License</a>
        <a href="/docs/introduction/">Documentation</a>
        <a href="/docs/accessibility/">Privacy & accessibility</a>
      </nav>
      <span>
        Made for little screens.
        <br />
        Open to everyone.
      </span>
    </footer>
    <script>
      document.querySelectorAll('pre').forEach((pre) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-code';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code');
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Select code to copy';
          }
          window.setTimeout(() => {
            button.textContent = 'Copy';
          }, 2400);
        });
        const wrapper = document.createElement('div');
        wrapper.className = 'code-wrapper';
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.append(pre, button);
      });
    </script>
  </body>
</html>

{
  "name": "@mochi/website",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "deploy": "npm run build && wrangler pages deploy dist --project-name mochi-sdk",
    "predev": "node scripts/sync-docs.mjs",
    "prebuild": "node scripts/sync-docs.mjs",
    "precheck": "node scripts/sync-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.43.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.130.0"
  }
}
